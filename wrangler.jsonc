{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "robonautshop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "robonautshop-product-images"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robonautshop-db",
      "database_id": "39a41e21-37a1-4f29-bd64-76d490f6692a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://robonautsshop.com/"
  }
}
