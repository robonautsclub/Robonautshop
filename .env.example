NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Only used locally, once, by `pnpm admin:bootstrap` (scripts/bootstrap-admin.ts).
# Never commit real values. Not read by the running app.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Resend transactional email (welcome + order confirmation).
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
RESEND_API_KEY=
# Optional verified sender. Defaults to Robonautsshop <onboarding@resend.dev>
RESEND_FROM_EMAIL=
# Amazon SES (SESv2) — reusable helper in lib/email/ses.ts
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Verified identity email (or "Name <email@domain>")
SES_FROM_EMAIL=
# Inbox that receives contact form submissions (app/api/contact/route.ts).
# While the SES account is in the sandbox, this address must be SES-verified too.
CONTACT_FORM_TO_EMAIL=
# Where low-stock alerts are sent (tasks/phase-14-advanced/93-inventory-alerts.md).
# Alerts are skipped (no-op) if unset.
ADMIN_ALERT_EMAIL=
# bKash Checkout (URL) — sandbox or live credentials from bKash onboarding.
# Token responses are cached in D1 (`bkash_tokens`) until near expiry.
BKASH_CHECKOUT_URL_BASE=
BKASH_CHECKOUT_URL_APP_KEY=
BKASH_CHECKOUT_URL_APP_SECRET=
BKASH_CHECKOUT_URL_USER_NAME=
BKASH_CHECKOUT_URL_PASSWORD=
