{
  "name": "robonautsshop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply robonautsshop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply robonautsshop-db --remote",
    "db:seed:generate": "tsx scripts/generate-seed-sql.ts",
    "db:seed:local": "pnpm db:seed:generate && wrangler d1 execute robonautsshop-db --local --file=.seed/seed.sql",
    "db:seed:remote": "pnpm db:seed:generate && wrangler d1 execute robonautsshop-db --remote --file=.seed/seed.sql",
    "admin:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/infra": "^0.4.10",
    "@faker-js/faker": "^10.6.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
